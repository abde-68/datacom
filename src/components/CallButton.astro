---
import { site } from '../data/site';
const tel = site.telephoneLien || '';
---
<!-- Bouton d'appel flottant sur mobile -->
<a
  href={tel ? `tel:${tel}` : '/contact'}
  class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-safety px-5 py-3 font-semibold text-electric-dark shadow-card lg:hidden"
  aria-label="Appeler DATACOM"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  Appeler
</a>
