---
import { nav, site } from '../data/site';
---
<header class="sticky top-0 z-50 w-full border-b border-black/5 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="DATACOM accueil">
      <img src="/logo-datacom.svg" alt="DATACOM electricite et fibre optique" class="h-9 w-auto" width="320" height="72" />
    </a>

    <!-- Navigation bureau -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      {nav.map((item) => (
        item.children ? (
          <div class="group relative">
            <button type="button" class="flex items-center gap-1 rounded-lg px-3 py-2 font-medium text-electric-dark hover:text-electric" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="invisible absolute left-0 top-full w-60 translate-y-1 rounded-xl bg-white p-2 opacity-0 shadow-card ring-1 ring-black/5 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
              {item.children.map((c) => (
                <a href={c.href} class="block rounded-lg px-4 py-2 text-electric-dark hover:bg-surface hover:text-electric">{c.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="rounded-lg px-3 py-2 font-medium text-electric-dark hover:text-electric">{item.label}</a>
        )
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href="/contact" class="btn-primary">Demander un devis</a>
    </div>

    <!-- Bouton menu mobile -->
    <button id="menu-toggle" type="button" class="lg:hidden rounded-lg p-2 text-electric-dark" aria-label="Ouvrir le menu" aria-controls="mobile-menu" aria-expanded="false">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden border-t border-black/5 bg-white lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Navigation mobile">
      <a href="/" class="rounded-lg px-3 py-2 font-medium hover:bg-surface">Accueil</a>
      <details class="rounded-lg">
        <summary class="cursor-pointer list-none rounded-lg px-3 py-2 font-medium hover:bg-surface">Nos services</summary>
        <div class="ml-3 flex flex-col">
          <a href="/electricite-generale" class="rounded-lg px-3 py-2 hover:bg-surface">Electricite generale</a>
          <a href="/fibre-optique" class="rounded-lg px-3 py-2 hover:bg-surface">Fibre optique</a>
        </div>
      </details>
      <a href="/a-propos" class="rounded-lg px-3 py-2 font-medium hover:bg-surface">A propos</a>
      <a href="/realisations" class="rounded-lg px-3 py-2 font-medium hover:bg-surface">Realisations</a>
      <a href="/faq" class="rounded-lg px-3 py-2 font-medium hover:bg-surface">FAQ</a>
      <a href="/contact" class="rounded-lg px-3 py-2 font-medium hover:bg-surface">Contact</a>
      <a href="/contact" class="btn-primary mt-2">Demander un devis</a>
    </nav>
  </div>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    toggle?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  </script>
</header>
