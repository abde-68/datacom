---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable" description="La page demandee n'existe pas.">
  <section class="section">
    <div class="container-page text-center">
      <p class="text-6xl font-extrabold text-electric">404</p>
      <h1 class="mt-4 h-title">Page introuvable</h1>
      <p class="mt-3 text-electric-dark/70">La page que vous cherchez n'existe pas ou a ete deplacee.</p>
      <a href="/" class="btn-primary mt-6">Retour a l'accueil</a>
    </div>
  </section>
</BaseLayout>
